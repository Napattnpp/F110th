# 1. Use the hardware-accelerated Jetson L4T image
FROM dustynv/ros:humble-desktop-l4t-r36.4.0

# Build-time user args (injected from docker-compose / .env)
ARG USER=f110th
ARG UID=1000
ARG GID=1000

# Refresh ROS keyring
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg

# 2. ROS core setup & locales
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8
ENV ROS_DISTRO=humble

# 3. Cyclone DDS Configuration
COPY ./configs/dds/cyclonedds_car.xml /etc/cyclonedds.xml
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml

# 4. Additional installations
# NOTE: micro-ROS is NOT installed here. The dustynv base image provides
#       GPU-accelerated ROS; install micro-ROS on the host or use the
#       general image for agent development.
RUN apt-get update && apt-get install -y \
    sudo \
    nano \
    vim \
    tmux \
    htop \
    iputils-ping \
    net-tools \
    git \
    wget \
    curl \
    python3-pip \
    python3-numpy \
    python3-scipy \
    udev \
    i2c-tools \
    gfortran \
    libxcb-cursor0 \
    && rm -rf /var/lib/apt/lists/*



RUN apt-get update && apt-get install -y equivs \
    && printf "Section: misc\nPriority: optional\nStandards-Version: 3.9.2\nPackage: opencv-dummy\nProvides: libopencv-core-dev, libopencv-flann-dev, libopencv-imgproc-dev, libopencv-imgcodecs-dev, libopencv-videoio-dev, libopencv-highgui-dev, libopencv-ml-dev, libopencv-features2d-dev, libopencv-calib3d-dev, libopencv-dnn-dev, libopencv-objdetect-dev, libopencv-photo-dev, libopencv-video-dev, libopencv-shape-dev, libopencv-stitching-dev, libopencv-superres-dev, libopencv-videostab-dev, libopencv-contrib-dev, libopencv-dev, opencv-data\nDescription: Dummy package for NVIDIA OpenCV\n" > /tmp/opencv-dummy.control \
    && cd /tmp && equivs-build opencv-dummy.control \
    && dpkg -i opencv-dummy_1.0_all.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/*

RUN apt-get update && apt-get install -y \
    python3-rosdep \
    ros-$ROS_DISTRO-turtlesim \
    ros-$ROS_DISTRO-rqt \
    ros-$ROS_DISTRO-rmw-cyclonedds-cpp \
    ros-$ROS_DISTRO-rmw-zenoh-cpp \
    ros-$ROS_DISTRO-rqt-common-plugins \
    ros-$ROS_DISTRO-slam-toolbox \
    ros-$ROS_DISTRO-cartographer \
    ros-$ROS_DISTRO-cartographer-ros \
    ros-$ROS_DISTRO-navigation2 \
    ros-$ROS_DISTRO-nav2-bringup \
    ros-$ROS_DISTRO-ackermann-msgs \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    ros-$ROS_DISTRO-serial-driver \
    ros-$ROS_DISTRO-asio-cmake-module \
    ros-$ROS_DISTRO-ament-cmake-auto \
    ros-$ROS_DISTRO-ament-lint-auto \
    ros-$ROS_DISTRO-ament-lint-common \
    ros-$ROS_DISTRO-joy \
    ros-$ROS_DISTRO-urg-node \
    ros-$ROS_DISTRO-xacro \
    ros-$ROS_DISTRO-robot-state-publisher \
    ros-$ROS_DISTRO-joy-teleop \
    ros-$ROS_DISTRO-foxglove-bridge \
    ros-$ROS_DISTRO-tf-transformations \
    ros-$ROS_DISTRO-robot-localization \
    ros-$ROS_DISTRO-imu-filter-madgwick \
    ros-$ROS_DISTRO-laser-proc \
    ros-$ROS_DISTRO-diagnostic-updater \
    && rm -rf /var/lib/apt/lists/*

# Install additional Python packages (ensure transforms3d>=0.4.2 to prevent np.float deprecation, yamldataclassconfig<2 for gym)
RUN rm -rf /usr/lib/python3/dist-packages/transforms3d* \
    && python3 -m pip install --ignore-installed --index-url https://pypi.org/simple smbus2 "transforms3d>=0.4.2" tqdm "numpy<2" scikit-image trajectory-planning-helpers casadi scikit-learn filterpy numba pandas matplotlib pynput quadprog==0.1.11 "yamldataclassconfig>=1.5.0,<2" uv git+https://github.com/f1tenth/f1tenth_gym.git@dev-humble

# 5. Create non-root user matching the host UID/GID
RUN groupadd -f -g ${GID} ${USER} \
    && groupadd -f -g 23 host-input \
    && useradd -ms /bin/bash -u ${UID} -g ${GID} ${USER} \
    && echo "${USER} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && mkdir -p /home/${USER}/F110th/out \
    && chown -R ${UID}:${GID} /home/${USER}/F110th

# 6. Configure user environment
USER ${USER}
RUN echo "if [ -f /opt/ros/$ROS_DISTRO/install/setup.bash ]; then source /opt/ros/$ROS_DISTRO/install/setup.bash; fi" >> /home/${USER}/.bashrc \
    && echo "if [ -f /opt/ros/$ROS_DISTRO/setup.bash ]; then source /opt/ros/$ROS_DISTRO/setup.bash; fi" >> /home/${USER}/.bashrc \
    && echo "if [ -f /home/${USER}/F110th/out/install/setup.bash ]; then source /home/${USER}/F110th/out/install/setup.bash; fi" >> /home/${USER}/.bashrc \
    && echo "export CYCLONEDDS_URI=file:///etc/cyclonedds.xml" >> /home/${USER}/.bashrc

USER root
COPY ./.devcontainer/docker/ros_entrypoint.sh /
RUN chmod +x /ros_entrypoint.sh

USER ${USER}
WORKDIR /home/${USER}/F110th

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]