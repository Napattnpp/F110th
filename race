                        disable_aeb_idx = (disable_aeb_idx + 1) % len(vals)

            elif ch == 10:
                item = items[selected_row]
                label, itype, vals, ref = item
                if itype == "action":
                    key = vals[0]
                    if procs[key] is not None:
                        try:
                            pgid = os.getpgid(procs[key].pid)
                            os.killpg(pgid, signal.SIGINT)
                            os.killpg(pgid, signal.SIGCONT)
                        except Exception:
                            pass
                        try:
                            procs[key].send_signal(signal.SIGINT)
                            procs[key].send_signal(signal.SIGCONT)
                        except Exception:
                            pass
                        procs[key] = None
                    else:
                        p_name = profiles[profile_idx]
                        m_name = maps[map_idx]
                        sim_val = sim_options[sim_idx]
                        ctrl_val = ctrl_options[ctrl_idx]
                        overtake_val = overtake_options[overtake_idx]
                        slam_val = slam_options[slam_idx]
                        loc_val = loc_options[loc_idx]
                        mode_val = mode_options[mode_idx]
                        racecar_val = active_profile.get("racecar_version", "NUC1")
                        table_val = active_profile.get("LU_table", "NUC1_hangar_pacejka")
                        traj_val = traj_options[traj_idx]
                        disable_aeb_val = disable_aeb_options[disable_aeb_idx]

                        cmd = []
                        if key == "tier1":
                            cmd = [
                                "ros2", "launch", "race_bringup", "base_launch.py",
                                f"map_name:={m_name}",
                                f"sim:={sim_val}",
                                f"racecar_version:={racecar_val}",
                                f"localize_method:={loc_val}",
                                f"trajectory_type:={traj_val}",
                                "disable_aeb:=False"
                            ]
                        elif key == "tier2":
                            cmd = [
                                "ros2", "launch", "foxglove_bridge", "foxglove_bridge_launch.xml"
                            ]
                        elif key == "tier3":
                            if mode_val == "timetrials":
                                cmd = [
                                    "ros2", "launch", "race_bringup", "timetrials_launch.py",
                                    f"ctrl_algo:={ctrl_val}",
                                    f"LU_table:={table_val}",
                                    f"racecar_version:={racecar_val}"
                                ]
                            elif mode_val == "qualifying":
                                cmd = [
                                    "ros2", "launch", "race_bringup", "qualifying_launch.py",
                                    f"ctrl_algo:={ctrl_val}",
                                    f"LU_table:={table_val}",
                                    f"racecar_version:={racecar_val}"
                                ]
                            elif mode_val == "h2h":
                                cmd = [
                                    "ros2", "launch", "race_bringup", "head_to_head_launch.py",
                                    f"sim:={sim_val}",
                                    f"ctrl_algo:={ctrl_val}",
                                    f"LU_table:={table_val}",
                                    f"overtake_mode:={overtake_val}",
                                    f"racecar_version:={racecar_val}"
                                ]
                            elif mode_val == "mapping":
                                cmd = [
                                    "ros2", "launch", "race_bringup", "mapping_launch.py",
                                    f"map_name:={m_name}",
                                    f"sim:={sim_val}",
                                    f"slam_method:={slam_val}",
                                    f"racecar_version:={racecar_val}"
                                ]
                        
                        if cmd:
                            try:
                                flog = open(log_files[key], "w")
                                procs[key] = subprocess.Popen(cmd, stdout=flog, stderr=flog, start_new_session=True)
                            except FileNotFoundError:
                                with open(log_files[key], "w") as f:
                                    f.write("Error: Command not found. Are you running inside the Docker container with ROS 2 installed?\n")
                                procs[key] = None
                
                elif itype == "view_logs":
                    curses.endwin()
                    print("\n\033[36m--- Viewing Live Logs. Press Ctrl+C to stop viewing and return to menu ---\033[0m\n")
                    try:
                        for lf in log_files.values():
                            open(lf, 'a').close()
                        subprocess.call(["tail", "-f"] + list(log_files.values()))
                    except KeyboardInterrupt:
                        pass
                    finally:
                        stdscr.clear()
                        stdscr.refresh()
                
                elif itype == "exit_keep":
                    return
                elif itype == "exit_stop":
                    cleanup_procs()
                    return

            time.sleep(0.05)

    try:
        curses.wrapper(draw_menu)
    finally:
        pass

def main():
    if len(sys.argv) < 2:
        try:
            run_tui()
        except KeyboardInterrupt:
            pass
        sys.exit(0)

    parser = argparse.ArgumentParser(description="F1TENTH Workflow Profile Manager CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # profile
    p_parser = subparsers.add_parser("profile", help="Manage configuration profiles")
    
    # tui
    subparsers.add_parser("tui", help="Launch interactive TUI launcher")
    p_sub = p_parser.add_subparsers(dest="subcommand", required=True)
    p_sub.add_parser("list", help="List available profiles")
    
    switch_p = p_sub.add_parser("switch", help="Switch active profile")
    switch_p.add_argument("name", type=str, help="Profile name (e.g. sim, nuc1)")
    
    p_sub.add_parser("show", help="Show active configuration")

    # mapping
    m_parser = subparsers.add_parser("mapping", help="Launch mapping session")
    m_parser.add_argument("--map", type=str, help="Map name to create")
    m_parser.add_argument("--sim", type=str, choices=["True", "False"], help="Run in simulation")
    m_parser.add_argument("--racecar", type=str, help="Racecar version")
    m_parser.add_argument("--slam", type=str, choices=["cartographer", "slam_toolbox"], help="SLAM method")
    m_parser.add_argument("--run-ftg", type=str, choices=["True", "False"], help="Auto run ftg_mapper")
    m_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # base
    b_parser = subparsers.add_parser("base", help="Launch base system only")
    b_parser.add_argument("--map", type=str, help="Map name")
    b_parser.add_argument("--sim", type=str, choices=["True", "False"], help="Run in simulation")
    b_parser.add_argument("--racecar", type=str, help="Racecar version")
    b_parser.add_argument("--localize", type=str, choices=["True", "False"], help="Enable localization")
    b_parser.add_argument("--method", type=str, choices=["amcl", "cartographer", "particle_filter"], help="Localization method")
    b_parser.add_argument("--trajectory", type=str, choices=["minimum_curvature", "shortest_path", "centerline"], help="Trajectory type")
    b_parser.add_argument("--disable-aeb", type=str, choices=["True", "False"], help="Disable safety AEB node")
    b_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # qualifying
    q_parser = subparsers.add_parser("qualifying", help="Launch full qualifying stack")
    q_parser.add_argument("--racecar", type=str, help="Racecar version")
    q_parser.add_argument("--ctrl", type=str, help="Control algorithm (PP/MAP)")
    q_parser.add_argument("--table", type=str, help="Lookup table parameter")
    q_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # h2h
    h_parser = subparsers.add_parser("h2h", help="Launch full head-to-head stack")
    h_parser.add_argument("--sim", type=str, choices=["True", "False"], help="Run in simulation")
    h_parser.add_argument("--racecar", type=str, help="Racecar version")
    h_parser.add_argument("--ctrl", type=str, help="Control algorithm (PP/MAP)")
    h_parser.add_argument("--table", type=str, help="Lookup table parameter")
    h_parser.add_argument("--overtake", type=str, choices=["spliner", "graph_based"], help="Overtake planner mode")
    h_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # ftg
    ftg_parser = subparsers.add_parser("ftg", help="Run Follow the Gap controller node standalone")
    ftg_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # telemetry
    tel_parser = subparsers.add_parser("telemetry", help="Launch telemetry / Foxglove bridge")
    tel_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # finish-map
    fm_parser = subparsers.add_parser("finish-map", help="Finish and save mapping session")
    fm_parser.add_argument("name", type=str, help="Saved map name")
    fm_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    # edit-waypoints
    ew_parser = subparsers.add_parser("edit-waypoints", help="Interactively adjust waypoints away from outer walls")
    ew_parser.add_argument("map_name", nargs="?", default="track4", help="Map name to edit waypoints for")

    # edit-map
    em_parser = subparsers.add_parser("edit-map", help="Launch map editor")
    em_parser.add_argument("--map", type=str, help="Map name")
    em_parser.add_argument("--dry-run", action="store_true", help="Print command without executing")

    args = parser.parse_args()

    # Routing
    if args.command == "profile":
        if args.subcommand == "list":
            handle_profile_list(args)
        elif args.subcommand == "switch":
            handle_profile_switch(args)
        elif args.subcommand == "show":
            handle_profile_show(args)
    elif args.command == "mapping":
        handle_mapping(args)
    elif args.command == "base":
        handle_base(args)
    elif args.command == "qualifying":
        handle_qualifying(args)
    elif args.command == "h2h":
        handle_h2h(args)
    elif args.command == "ftg":
        handle_ftg(args)
    elif args.command == "telemetry":
        handle_telemetry(args)
    elif args.command == "tui":
        try:
            run_tui()
        except KeyboardInterrupt:
            pass
        sys.exit(0)
    elif args.command == "finish-map":
        handle_finish_map(args)
    elif args.command == "edit-map":
        handle_edit_map(args)
    elif args.command == "edit-waypoints":
        cmd = [sys.executable, os.path.join(PROJECT_ROOT, "scripts", "edit_waypoints_gui.py"), getattr(args, "map_name", "track4")]
        subprocess.call(cmd)

if __name__ == "__main__":
    main()
