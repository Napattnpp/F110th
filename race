    class ExternalProcess:
        def __init__(self, pid):
            self.pid = pid

        def poll(self):
            try:
                output = subprocess.check_output(["ps", "-o", "state=", "-p", str(self.pid)], text=True).strip()
                if not output or output.startswith('Z') or output.startswith('T'):
                    return 0  # Stopped or Zombie
                return None  # Still running
            except Exception:
                return 0  # Stopped

        def send_signal(self, sig):
            try:
                os.kill(self.pid, sig)
            except OSError:
                pass

        def kill(self):
            try:
                import signal
                os.kill(self.pid, signal.SIGKILL)
            except OSError:
                pass

        def wait(self):
            while self.poll() is None:
                time.sleep(0.1)

    def get_running_pids_for_keywords(keywords):
        pids = []
        try:
            output = subprocess.check_output(["ps", "-ax", "-o", "pid,state,args"], text=True)
            for line in output.splitlines():
                line = line.strip()
                if not line:
                    continue
                parts = line.split(None, 2)
                if len(parts) < 3:
                    continue
                pid_str, state, cmd = parts
                if not pid_str.strip().isdigit():
                    continue
                pid = int(pid_str)
                if state.startswith('T') or state.startswith('Z'):
                    continue
                # Exclude the current process and the ps command itself
                if pid == os.getpid() or "ps -ax" in cmd:
                    continue
                # Exclude other instances of the TUI launcher script (avoiding race_bringup packages)
                if ("race " in cmd or cmd.endswith("race")) and "race_bringup" not in cmd:
                    continue
                if all(k in cmd for k in keywords):
                    pids.append(pid)
        except Exception:
            pass
        return pids

    def find_running_tier_pid(tier_key):
        keywords_map = {
            "tier1": ["base_launch.py"],
            "tier2": ["foxglove_bridge"],
            "tier3_timetrials": ["timetrials_launch.py"],
            "tier3_qualifying": ["qualifying_launch.py"],
            "tier3_h2h": ["head_to_head_launch.py"],
            "tier3_mapping": ["mapping_launch.py"],
        }
        if tier_key == "tier3":
            for key in ["tier3_timetrials", "tier3_qualifying", "tier3_h2h", "tier3_mapping"]:
                pids = get_running_pids_for_keywords(keywords_map[key])
                if pids:
                    return pids[0]
            return None
        else:
            pids = get_running_pids_for_keywords(keywords_map[tier_key])
            return pids[0] if pids else None

    procs = {"tier1": None, "tier2": None, "tier3": None}
    for key in procs:
        pid = find_running_tier_pid(key)
        if pid is not None:
            procs[key] = ExternalProcess(pid)

    log_files = {
        "tier1": os.path.join(log_dir, "base_system.log"),
        "tier2": os.path.join(log_dir, "telemetry.log"),
        "tier3": os.path.join(log_dir, "algorithm.log"),
    }

    def cleanup_procs():
        for key in procs:
            if procs[key] is not None and procs[key].poll() is None:
                try:
                    pgid = os.getpgid(procs[key].pid)
                    os.killpg(pgid, signal.SIGINT)
                    os.killpg(pgid, signal.SIGCONT)
                except Exception:
                    pass
                try:
                    procs[key].send_signal(signal.SIGINT)
                    procs[key].send_signal(signal.SIGCONT)
                except Exception:
                    pass
        time.sleep(0.5)
        for key in procs:
            if procs[key] is not None and procs[key].poll() is None:
                try:
                    pgid = os.getpgid(procs[key].pid)
                    os.killpg(pgid, signal.SIGKILL)
                except Exception:
                    pass
                try:
                    procs[key].kill()
                except Exception:
                    pass
                procs[key] = None

