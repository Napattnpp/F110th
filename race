#!/usr/bin/env python3
import os
import sys
import yaml
import shutil
import argparse
import subprocess

PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))
PROFILES_DIR = os.path.join(PROJECT_ROOT, "profiles")
ACTIVE_CONFIG_PATH = os.path.join(PROFILES_DIR, "active_profile.yaml")

def load_yaml(path):
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r") as f:
            return yaml.safe_load(f) or {}
    except Exception as e:
        print(f"Error loading {path}: {e}")
        return {}

def save_yaml(data, path):
    try:
        with open(path, "w") as f:
            yaml.safe_dump(data, f, default_flow_style=False)
    except Exception as e:
        print(f"Error saving to {path}: {e}")

def get_active_profile():
    return load_yaml(ACTIVE_CONFIG_PATH)

def run_command(cmd, dry_run=False):
    print(f"\n[Running Command]: {' '.join(cmd)}")
    if dry_run:
        print("[DRY-RUN]: Command not executed.")
        return 0
    try:
        # We run the command inside bash to source the ROS workspace if needed, 
        # but since we are executing in the container or host, running directly is fine.
        process = subprocess.Popen(cmd, stdout=sys.stdout, stderr=sys.stderr)
        process.communicate()
        return process.returncode
    except KeyboardInterrupt:
        print("\nCommand interrupted by user.")
        return 130
    except Exception as e:
        print(f"Failed to run command: {e}")
        return 1

# Commands
def handle_profile_list(args):
    if not os.path.exists(PROFILES_DIR):
        print("No profiles directory found.")
        return
    print("Available Profiles:")
    for f in sorted(os.listdir(PROFILES_DIR)):
        if f.endswith(".yaml"):
            name = f[:-5]
            if name == "active_profile":
                continue
            active_marker = "*" if get_active_profile().get("profile_name") == name else " "
            print(f" {active_marker} {name}")

def handle_profile_switch(args):
    if args.name == "active_profile":
        print("Cannot switch directly to 'active_profile' profile.")
        return
    profile_path = os.path.join(PROFILES_DIR, f"{args.name}.yaml")
    if not os.path.exists(profile_path):
        print(f"Profile '{args.name}' does not exist at {profile_path}")
        return
    
    data = load_yaml(profile_path)
    data["profile_name"] = args.name
    save_yaml(data, ACTIVE_CONFIG_PATH)
    print(f"Switched active profile to '{args.name}'.")
    handle_profile_show(args)

def handle_profile_show(args):
    profile = get_active_profile()
    if not profile:
        print("No active profile configured.")
        return
    print("Active Profile Configuration:")
    print(yaml.safe_dump(profile, default_flow_style=False))

def handle_mapping(args):
    profile = get_active_profile()
    map_name = args.map or profile.get("map_name", "latest")
    sim = args.sim if args.sim is not None else str(profile.get("sim", False))
    racecar = args.racecar or profile.get("racecar_version", "NUC1")
    slam = args.slam or profile.get("slam_method", "cartographer")
    run_ftg = args.run_ftg or "True"

    cmd = [
        "ros2", "launch", "race_bringup", "mapping_launch.py",
        f"map_name:={map_name}",
        f"sim:={sim}",
        f"racecar_version:={racecar}",
        f"slam_method:={slam}",
        f"run_ftg:={run_ftg}"
    ]
    sys.exit(run_command(cmd, args.dry_run))

