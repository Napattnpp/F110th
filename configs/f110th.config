# ==============================================================================
#  F110th — Project Configuration
#  Edit this file to match your setup, then run:  ./setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# ROS 2 Settings
# ------------------------------------------------------------------------------

# ROS Domain ID (0–101). All machines in the same session must share this value.
ROS_DOMAIN_ID=21

# ROS Middleware. Options: rmw_cyclonedds_cpp | rmw_fastrtps_cpp | rmw_zenoh_cpp
RMW_IMPLEMENTATION=rmw_zenoh_cpp

# Target car IP or mDNS hostname for remote visualization (e.g. Pit connection)
CAR_IP=orin-desktop.local

# ------------------------------------------------------------------------------
# Racecar / Platform Settings
# ------------------------------------------------------------------------------

# Racecar identifier (used inside the container for launch files, etc.)
# Examples: NUC1, NUC2, JET1, JET2
RACECAR_VERSION=NUC1

# Docker profile to use. Options: general | jetson
# 'general'  → x86 / ARM laptop (development & simulation)
# 'jetson'   → NVIDIA Jetson (on-car deployment)
DOCKER_PROFILE=jetson

# ------------------------------------------------------------------------------
# Docker Image (used by `make push`)
# ------------------------------------------------------------------------------

DOCKERHUB_USER=napattnpp
IMAGE_NAME=f110th_img
