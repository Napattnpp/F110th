# ==============================================================================
#  F110th — Single Source of Truth Project Configuration (.env.example)
#  Copy this file to .env or run `make setup` to initialize automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Racecar Operational Role & Identifier
# ------------------------------------------------------------------------------
# Operational mode (Options: simulation | vehicle)
# - simulation: Local Mac/Laptop development and 2D simulator.
# - vehicle: Onboard compute on physical car (Jetson / NUC).
F110_ROLE=simulation


# Target Racecar Hardware Identifier (e.g. car01, car02, NUC1, JET1)
RACECAR_ID=car01

# Racecar Hostname on local network (e.g. car01.local or IP address)
CAR_HOSTNAME=car01.local

# ------------------------------------------------------------------------------
# 2. ROS 2 Network & Traffic Isolation
# ------------------------------------------------------------------------------
# ROS Domain ID (0–101). Prevents cross-talk between team cars.
ROS_DOMAIN_ID=21

# ROS 2 Network Discovery Range (Options: LOCALHOST | SUBNET)
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# ROS 2 Middleware Implementation (Options: rmw_cyclonedds_cpp | rmw_fastrtps_cpp | rmw_zenoh_cpp)
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# CycloneDDS Profile is automatically derived from F110_ROLE by `configure.sh`:
# - vehicle    -> cyclonedds_car.xml (locked to 127.0.0.1 for Foxglove Bridge & 0% Wi-Fi noise)
# - simulation -> cyclonedds_dev.xml (multicast discovery for local dev)
# Optional override (uncomment if custom profile needed):
# CYCLONEDDS_PROFILE=cyclonedds_dev.xml


# ------------------------------------------------------------------------------
# 3. Docker Registry & Image Configuration
# ------------------------------------------------------------------------------
DOCKERHUB_USER=your_dockerhub_username
IMAGE_NAME=f110th_img
