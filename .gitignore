# Colcon build directories (legacy — now lives in out/)
build/
install/
log/

# Colcon build output (generated by setup.sh / make setup_build_output)
out/

# Optional: Ignore common local workspace artifacts
.colcon/
.vscode/
**/__pycache__/
*.pyc
*.bak

# Editor swap files
*.swp
*.swo
*.swn

# Local runtime data and logs
data/
*.log

# Environment variables (generated by setup.sh)
.env

# OS files
.DS_Store

# Generated ROS graphs & diagrams (e.g. rqt_graph outputs)
*.gv
*.pdf

# Python Virtual Environments
.venv/
venv/
env/
dist/
*.egg-info/

# ROS 2 assets
rosbag2_*/
*.db3
*.mcap
*_bag*/

# Documentation folder
docs/

# Ignore assets contents but keep the directories
# assets/maps/*
!assets/maps/.gitkeep
assets/frames/*
!assets/frames/.gitkeep
assets/bags/*
!assets/bags/.gitkeep
