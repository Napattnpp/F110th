# Colcon build directories (legacy — now lives in out/)
build/
install/
log/

# Colcon build output (generated by setup.sh / make setup)
out/

# Optional: Ignore common local workspace artifacts
.colcon/
.vscode/
.idea/
.ipynb_checkpoints/
**/__pycache__/
*.pyc
*.bak
*.tmp
.pytest_cache/
.coverage
htmlcov/

# Editor swap files
*.swp
*.swo
*.swn
*~

# Local runtime data and logs
data/
*.log

# Environment variables (generated by make setup)
.env

# OS files
.DS_Store
._*
Thumbs.db

# Generated ROS graphs & diagrams (e.g. rqt_graph outputs)
*.gv
*.pdf

# Python Virtual Environments
.venv/
.venv_mac/
venv/
env/
dist/
*.egg-info/

# ROS 2 assets & Bags
rosbag2_*/
*.db3
*.mcap
*_bag*/

# Ignore assets contents but keep the directories
!assets/maps/.gitkeep
assets/frames/*
!assets/frames/.gitkeep
assets/bags/*
!assets/bags/.gitkeep
assets/maps_visualization/*
!assets/maps_visualization/.gitkeep
!assets/maps_visualization/**/.gitkeep
