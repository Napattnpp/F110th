<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>odom_to_path</name>
  <version>0.0.1</version>
  <description>
    Subscribes to /odom (nav_msgs/msg/Odometry) and publishes the accumulated
    robot path on /path (nav_msgs/msg/Path) with bounded memory and configurable
    publish rate.
  </description>

  <maintainer email="napattnpp@example.com">Napattnpp</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
