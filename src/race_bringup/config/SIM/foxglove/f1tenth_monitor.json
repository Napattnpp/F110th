  "userNodes": {
    "f1tenth_telemetry_converter": {
      "sourceCode": "import { Input, MessageEvent } from 'ros';\n\ntype InputDrive = MessageEvent<Input<'/drive'>>;\ntype InputOdom = MessageEvent<Input<'/car_state/odom'>>;\n\nexport const inputs = ['/drive', '/car_state/odom'];\nexport const output = '/telemetry/gauges';\n\nlet lastSpeedMs = 0.0;\nlet lastSteerDeg = 0.0;\n\nexport default function publisher(event: InputDrive | InputOdom) {\n  if (event.topic === '/drive') {\n    const msg = event.message as any;\n    if (msg?.drive?.steering_angle != null) {\n      lastSteerDeg = msg.drive.steering_angle * (180 / Math.PI);\n    }\n  }\n  if (event.topic === '/car_state/odom') {\n    const msg = event.message as any;\n    const vx = msg?.twist?.twist?.linear?.x ?? 0.0;\n    const vy = msg?.twist?.twist?.linear?.y ?? 0.0;\n    lastSpeedMs = Math.hypot(vx, vy);\n  }\n  return {\n    speed_ms: Number(lastSpeedMs.toFixed(2)),\n    steering_deg: Number(lastSteerDeg.toFixed(1))\n  };\n}\n",
      "name": "F1tenthTelemetryConverter"
    }
  },
